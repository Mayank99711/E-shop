generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SHOP_OWNER
  CUSTOMER
  SHOP_EMPLOYEE
}

enum ShopStatus {
  PENDING
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MasterDataType {
  CATEGORY
  BRAND
  VARIANT_ATTRIBUTE
  VARIANT_VALUE
}

enum MasterDataRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PAYMENT_PROCESSING
  INVENTORY_ALLOCATED
  PICKING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum AccountDeletionStatus {
  PENDING
  ACKNOWLEDGED
  REJECTED
  CANCELLED
}

model User {
  couponRedemptions ShopCouponRedemption[]
  id                       String                    @id @default(uuid()) @db.Uuid
  role                     UserRole
  name                     String
  email                    String                    @unique
  ownerCode                String?                   @unique
  mobile                   String?
  passwordHash             String?
  sessionVersion           Int                       @default(0)
  profileImageUrl          String?
  isActive                 Boolean                   @default(true)
  emailVerifiedAt          DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  ownedShop                Shop?
  favourites               Favourite[]
  addresses                Address[]
  cart                     Cart?
  orders                   Order[]
  masterDataRequests       MasterDataRequest[]       @relation("RequestSubmitter")
  reviewedRequests         MasterDataRequest[]       @relation("RequestReviewer")
  verificationCodes        EmailVerificationCode[]
  passwordResetTokens      PasswordResetToken[]
  activationTokens         OwnerActivationToken[]
  employeeActivationTokens EmployeeActivationToken[]
  auditLogs                AuditLog[]
  confirmedGoodsReceipts   GoodsReceipt[]            @relation("GoodsReceiptConfirmer")
  inventoryMovements       InventoryMovement[]       @relation("InventoryMovementActor")
  attendanceRecorded       EmployeeAttendance[]      @relation("AttendanceRecorder")
  salaryPaymentsRecorded   EmployeeSalaryPayment[]   @relation("SalaryPaymentRecorder")
  deletionRequest          AccountDeletionRequest?   @relation("AccountDeletionCustomer")
  reviewedDeletionRequests AccountDeletionRequest[]  @relation("AccountDeletionReviewer")
  productReviews           ProductReview[]

  employeeProfile Employee? @relation("EmployeeLoginAccount")
}

model Shop {
  coupons ShopCoupon[]
  customEmployeeRoles ShopEmployeeRole[]
  deliveryAssignments DeliveryAssignment[]
  id                    String                 @id @default(uuid()) @db.Uuid
  code                  String                 @unique
  name                  String
  categoryId            String?                @db.Uuid
  shopCategoryId        String?                @db.Uuid
  commissionPercentage  Decimal?               @db.Decimal(5, 2)
  businessName          String?                @db.VarChar(160)
  businessType          String?                @db.VarChar(100)
  taxId                 String?                @db.VarChar(100)
  gstNumber             String?                @db.VarChar(15)
  panNumber             String?                @db.VarChar(10)
  pinCode               String?                @db.VarChar(20)
  city                  String?                @db.VarChar(100)
  district              String?                @db.VarChar(100)
  state                 String?                @db.VarChar(100)
  country               String?                @db.VarChar(100)
  businessAddress       String?                @db.VarChar(500)
  contactPhone          String?                @db.VarChar(20)
  contactEmail          String?                @db.VarChar(254)
  logoUrl               String?                @db.VarChar(2048)
  ownerId               String                 @unique @db.Uuid
  status                ShopStatus             @default(PENDING)
  archivedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  owner                 User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category              Category?              @relation("ShopCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  shopCategory          ShopCategory?          @relation("ShopShopCategory", fields: [shopCategoryId], references: [id], onDelete: Restrict)
  products              Product[]
  variants              ProductVariant[]
  employees             Employee[]
  shopOrders            ShopOrder[]
  dataRequests          MasterDataRequest[]
  wholesalerAccess      ShopWholesaler[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  wholesaleBills        WholesaleBill[]
  wholesalePayments     WholesalePayment[]
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]

  employeeAttendance EmployeeAttendance[]
  payrollPeriods     EmployeePayrollPeriod[]
  salaryPayments     EmployeeSalaryPayment[]
}

model Category {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String     @unique
  description    String?
  isActive       Boolean    @default(true)
  parentId       String?    @db.Uuid
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[] @relation("CategoryTree")
  products       Product[]
  shops          Shop[]     @relation("ShopCategory")
  iconUrl        String?
  imageUrl       String?
}

model Brand {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String    @unique
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]
  logoUrl        String?
  imageUrl       String?   @db.VarChar(2048)
}

model VariantAttribute {
  id             String                  @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String                  @unique
  description    String?
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  imageUrl       String?                 @db.VarChar(2048)
  values         VariantAttributeValue[]
  productValues  ProductVariantValue[]
}

model VariantAttributeValue {
  id              String                @id @default(uuid()) @db.Uuid
  attributeId     String                @db.Uuid
  value           String
  normalizedValue String
  isActive        Boolean               @default(true)
  attribute       VariantAttribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  productValues   ProductVariantValue[]

  @@unique([attributeId, normalizedValue])
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  shopId      String  @db.Uuid
  categoryId  String  @db.Uuid
  brandId     String? @db.Uuid
  name        String
  description String

  masterSku         String?  @db.VarChar(80)
  shortDescription  String?  @db.VarChar(1000)
  basePrice         Decimal? @db.Decimal(12, 2)
  commissionPercent Decimal? @db.Decimal(5, 2)

  status       ProductStatus    @default(DRAFT)
  hsnCode      String?          @db.VarChar(10)
  gstRate      Decimal?         @db.Decimal(5, 4)
  taxInclusive Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  shop         Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand        Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  variants     ProductVariant[]
  favourites   Favourite[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reviews      ProductReview[]

  @@index([shopId, status])
  @@index([categoryId, status])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  shippingWeightGrams Int? // packed product weight in grams
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  shopId    String @db.Uuid
  sku       String

  variantName    String?  @db.VarChar(120)
  wholesalePrice Decimal? @db.Decimal(12, 2)
  markedPrice    Decimal? @db.Decimal(12, 2)

  combinationKey        String
  price                 Decimal                @db.Decimal(12, 2)
  discountPrice         Decimal?               @db.Decimal(12, 2)
  stock                 Int                    @default(0)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  product               Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  shop                  Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  values                ProductVariantValue[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]

  @@unique([shopId, sku])
  @@unique([productId, combinationKey])
  @@index([productId, isActive])
}

model ProductVariantValue {
  variantId   String                @db.Uuid
  attributeId String                @db.Uuid
  valueId     String                @db.Uuid
  variant     ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute   VariantAttribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  value       VariantAttributeValue @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeId])
}

model Favourite {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now())
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  label      String
  recipient  String
  mobile     String
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([customerId])
}

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String     @unique @db.Uuid
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  productId String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model ShopCoupon {
  id String @id @default(uuid()) @db.Uuid
  shopId String @db.Uuid
  code String
  discountType String
  discountValue Decimal @db.Decimal(12, 2)
  minimumOrder Decimal @default(0) @db.Decimal(12, 2)
  maxDiscount Decimal? @db.Decimal(12, 2)
  usageLimit Int?
  perCustomerLimit Int? @default(1)
  usedCount Int @default(0)
  isActive Boolean @default(true)
  startsAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  redemptions ShopCouponRedemption[]
  @@unique([shopId, code])
  @@index([shopId, isActive])
}

model ShopCouponRedemption {
  id String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  customerId String @db.Uuid
  orderId String @unique @db.Uuid
  createdAt DateTime @default(now())
  coupon ShopCoupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([couponId, customerId])
}

model Order {
  couponCode String?
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  couponRedemption ShopCouponRedemption?
  id                     String                 @id @default(uuid()) @db.Uuid
  orderNumber            String                 @unique
  customerId             String                 @db.Uuid
  addressId              String?                @db.Uuid
  status                 OrderStatus            @default(PLACED)
  subtotal               Decimal                @db.Decimal(12, 2)
  taxTotal               Decimal                @db.Decimal(12, 2)
  deliveryTotal          Decimal                @db.Decimal(12, 2)
  grandTotal             Decimal                @db.Decimal(12, 2)
  shippingSnapshot       Json
  checkoutIdempotencyKey String?                @unique @db.VarChar(128)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  customer               User                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address                Address?               @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shopOrders             ShopOrder[]
  payments               Payment[]
  inventoryReservations  InventoryReservation[]

  @@index([customerId, createdAt])
}

model ShopOrder {
  returnRequest ShopReturn?
  deliveryAssignment DeliveryAssignment?
  id            String               @id @default(uuid()) @db.Uuid
  orderId       String               @db.Uuid
  shopId        String               @db.Uuid
  status        OrderStatus          @default(PLACED)
  subtotal      Decimal              @db.Decimal(12, 2)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  order         Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shop          Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([orderId, shopId])
  @@index([shopId, status, createdAt])
}

model OrderItem {
  id          String          @id @default(uuid()) @db.Uuid
  shopOrderId String          @db.Uuid
  productId   String?         @db.Uuid
  variantId   String?         @db.Uuid
  productName String
  shopName    String
  sku         String
  unitPrice   Decimal         @db.Decimal(12, 2)
  quantity    Int
  hsnCode     String?         @db.VarChar(10)
  gstRate     Decimal?        @db.Decimal(5, 4)
  taxAmount   Decimal?        @db.Decimal(12, 2)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  shopOrder   ShopOrder       @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)
  review      ProductReview?
}

model ProductReview {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @db.Uuid
  productId   String    @db.Uuid
  orderItemId String    @unique @db.Uuid
  rating      Int
  title       String    @db.VarChar(120)
  comment     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customer    User      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([productId, createdAt])
}

model OrderStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  shopOrderId String      @db.Uuid
  status      OrderStatus
  note        String?
  createdAt   DateTime    @default(now())
  shopOrder   ShopOrder   @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)

  @@index([shopOrderId, createdAt])
}

model Payment {
  codCollection DeliveryCodCollection?
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @db.Uuid
  provider          String
  providerReference String?
  providerOrderId   String?
  providerPaymentId String?   @unique
  verifiedAt        DateTime?
  webhookEventId    String?

  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
}

model Employee {
  returnPickups ShopReturn[]
  deliveryAssignments DeliveryAssignment[]
  id           String @id @default(uuid()) @db.Uuid
  employeeCode String
  shopId       String @db.Uuid

  // Basic employee information
  name        String
  email       String?
  mobile      String
  designation String
  joiningDate DateTime
  isActive    Boolean  @default(true)

  // Employee login account (optional)
  userId String? @unique @db.Uuid

  // Assigned employee role
  employeeRole String?

  // Optional custom permissions.
  // Null means use role defaults.
  permissionOverrides Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Existing shop relation
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  // Employee login relationship
  user User? @relation("EmployeeLoginAccount", fields: [userId], references: [id], onDelete: SetNull)

  // Existing employee relationships
  salaryHistory  EmployeeSalaryHistory[]
  attendance     EmployeeAttendance[]
  payrollPeriods EmployeePayrollPeriod[]
  salaryPayments EmployeeSalaryPayment[]

  @@unique([shopId, employeeCode])
}

model EmployeeSalaryHistory {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime
  note          String?
  createdAt     DateTime @default(now())
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom])
}

model MasterDataRequest {
  id              String                  @id @default(uuid()) @db.Uuid
  type            MasterDataType
  proposedData    Json
  status          MasterDataRequestStatus @default(PENDING)
  rejectionReason String?
  requesterId     String                  @db.Uuid
  shopId          String                  @db.Uuid
  reviewerId      String?                 @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime                @default(now())
  requester       User                    @relation("RequestSubmitter", fields: [requesterId], references: [id], onDelete: Restrict)
  shop            Shop                    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  reviewer        User?                   @relation("RequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requesterId, createdAt])
}

model EmailVerificationCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  lastSentAt DateTime  @default(now())
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OwnerActivationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmployeeActivationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model AccountDeletionRequest {
  id         String                @id @default(uuid()) @db.Uuid
  customerId String                @unique @db.Uuid
  status     AccountDeletionStatus @default(PENDING)
  reason     String?               @db.VarChar(500)
  reviewerId String?               @db.Uuid
  reviewedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  customer   User                  @relation("AccountDeletionCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  reviewer   User?                 @relation("AccountDeletionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// PHASE5B ADDITIVE MODELS (pending approval)

enum WholesalerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum InventoryMovementReason {
  PURCHASE_RECEIPT
  MANUAL_ADJUSTMENT
  CUSTOMER_RETURN
}

model Wholesaler {
  id             String           @id @default(uuid()) @db.Uuid
  code           String           @unique
  name           String
  contactName    String?
  email          String?
  phone          String?
  status         WholesalerStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  shopAccess     ShopWholesaler[]
  purchaseOrders PurchaseOrder[]
  bills          WholesaleBill[]

  @@index([status, name])
}

model ShopWholesaler {
  id           String     @id @default(uuid()) @db.Uuid
  shopId       String     @db.Uuid
  wholesalerId String     @db.Uuid
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  shop         Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  wholesaler   Wholesaler @relation(fields: [wholesalerId], references: [id], onDelete: Restrict)

  @@unique([shopId, wholesalerId])
  @@index([shopId, isActive])
  @@index([wholesalerId, isActive])
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  shopId       String              @db.Uuid
  wholesalerId String              @db.Uuid
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Decimal             @db.Decimal(12, 2)
  submittedAt  DateTime?
  expectedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  wholesaler   Wholesaler          @relation(fields: [wholesalerId], references: [id], onDelete: Restrict)
  items        PurchaseOrderItem[]
  receipts     GoodsReceipt[]
  bills        WholesaleBill[]

  @@index([shopId, status, createdAt])
  @@index([wholesalerId, status, createdAt])
}

model PurchaseOrderItem {
  id               String             @id @default(uuid()) @db.Uuid
  purchaseOrderId  String             @db.Uuid
  productVariantId String             @db.Uuid
  quantityOrdered  Int
  unitPrice        Decimal            @db.Decimal(12, 2)
  lineTotal        Decimal            @db.Decimal(12, 2)
  receivedQuantity Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  receiptItems     GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productVariantId])
}

model GoodsReceipt {
  id              String             @id @default(uuid()) @db.Uuid
  purchaseOrderId String             @db.Uuid
  shopId          String             @db.Uuid
  status          GoodsReceiptStatus @default(DRAFT)
  receivedAt      DateTime           @default(now())
  confirmedAt     DateTime?
  confirmedById   String?            @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  shop            Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  confirmedBy     User?              @relation("GoodsReceiptConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  items           GoodsReceiptItem[]

  @@index([purchaseOrderId, createdAt])
  @@index([shopId, status, createdAt])
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid()) @db.Uuid
  goodsReceiptId      String            @db.Uuid
  purchaseOrderItemId String            @db.Uuid
  quantityReceived    Int
  quantityAccepted    Int
  quantityDamaged     Int               @default(0)
  quantityMissing     Int               @default(0)
  createdAt           DateTime          @default(now())
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
}

model InventoryMovement {
  id               String                  @id @default(uuid()) @db.Uuid
  shopId           String                  @db.Uuid
  productVariantId String                  @db.Uuid
  quantity         Int
  reason           InventoryMovementReason
  referenceType    String
  referenceId      String                  @db.Uuid
  actorId          String?                 @db.Uuid
  createdAt        DateTime                @default(now())
  shop             Shop                    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant          @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  actor            User?                   @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([referenceType, referenceId])
  @@index([shopId, productVariantId, createdAt])
  @@index([referenceType, referenceId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum PayrollStatus {
  PENDING
  PARTIAL
  PAID
}

model EmployeeAttendance {
  id           String           @id @default(uuid()) @db.Uuid
  employeeId   String           @db.Uuid
  shopId       String           @db.Uuid
  date         DateTime         @db.Date
  status       AttendanceStatus
  checkInAt    DateTime?
  checkOutAt   DateTime?
  workingHours Decimal?         @db.Decimal(6, 2)
  note         String?
  recordedById String?          @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shop         Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  recordedBy   User?            @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([shopId, date])
  @@index([employeeId, date])
}

model EmployeePayrollPeriod {
  id          String                  @id @default(uuid()) @db.Uuid
  employeeId  String                  @db.Uuid
  shopId      String                  @db.Uuid
  periodStart DateTime                @db.Date
  periodEnd   DateTime                @db.Date
  amountDue   Decimal                 @db.Decimal(12, 2)
  status      PayrollStatus           @default(PENDING)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  employee    Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shop        Shop                    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  payments    EmployeeSalaryPayment[]

  @@index([shopId, periodStart, periodEnd])
  @@index([employeeId, periodStart])
}

model EmployeeSalaryPayment {
  id              String                @id @default(uuid()) @db.Uuid
  payrollPeriodId String                @db.Uuid
  employeeId      String                @db.Uuid
  shopId          String                @db.Uuid
  amount          Decimal               @db.Decimal(12, 2)
  paidAt          DateTime              @default(now())
  paymentRef      String?
  idempotencyKey  String?               @db.VarChar(128)
  recordedById    String?               @db.Uuid
  createdAt       DateTime              @default(now())
  payrollPeriod   EmployeePayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee        Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shop            Shop                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  recordedBy      User?                 @relation("SalaryPaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@index([payrollPeriodId])
  @@index([employeeId, paidAt])
}

model InventoryReservation {
  id                     String                     @id @default(uuid()) @db.Uuid
  shopId                 String                     @db.Uuid
  productVariantId       String                     @db.Uuid
  quantity               Int
  status                 InventoryReservationStatus @default(ACTIVE)
  expiresAt              DateTime
  orderId                String?                    @db.Uuid
  checkoutIdempotencyKey String?                    @db.VarChar(128)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  shop                   Shop                       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  productVariant         ProductVariant             @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  order                  Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([shopId, status, expiresAt])
  @@index([productVariantId, status])
  @@index([checkoutIdempotencyKey])
}

enum InventoryReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

model PaymentWebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String    @unique
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider, eventId])
}

model ShopCategory {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String   @unique
  description    String?
  imageUrl       String?  @db.VarChar(2048)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  shops          Shop[]   @relation("ShopShopCategory")

  @@index([isActive, name])
}

enum WholesaleBillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum WholesalePaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

model WholesaleBill {
  id               String              @id @default(uuid()) @db.Uuid
  shopId           String              @db.Uuid
  wholesalerId     String              @db.Uuid
  purchaseOrderId  String              @db.Uuid
  invoiceNumber    String              @db.VarChar(100)
  invoiceDate      DateTime            @db.Date
  amount           Decimal             @db.Decimal(12, 2)
  filePath         String              @db.VarChar(500)
  originalFileName String              @db.VarChar(255)
  mimeType         String              @db.VarChar(100)
  status           WholesaleBillStatus @default(UNPAID)
  notes            String?             @db.VarChar(1000)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  wholesaler    Wholesaler         @relation(fields: [wholesalerId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  payments      WholesalePayment[]

  @@unique([shopId, wholesalerId, invoiceNumber])
  @@index([shopId, status, createdAt])
  @@index([purchaseOrderId])
}

model WholesalePayment {
  id                   String                 @id @default(uuid()) @db.Uuid
  shopId               String                 @db.Uuid
  billId               String                 @db.Uuid
  amount               Decimal                @db.Decimal(12, 2)
  method               WholesalePaymentMethod
  transactionReference String?                @db.VarChar(150)
  paymentDate          DateTime               @db.Date
  notes                String?                @db.VarChar(1000)
  idempotencyKey       String?                @unique @db.VarChar(128)
  createdAt            DateTime               @default(now())

  shop Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  bill WholesaleBill @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@index([shopId, paymentDate])
  @@index([billId, paymentDate])
}

// Assignment-scoped delivery workflow: order fulfilment status remains separate.
model DeliveryAssignment {
  codCollection DeliveryCodCollection?
  id String @id @default(uuid()) @db.Uuid
  shopOrderId String @unique @db.Uuid
  shopId String @db.Uuid
  employeeId String @db.Uuid
  status String @default("ASSIGNED") @db.VarChar(32)
  failureReason String? @db.VarChar(250)
  assignedAt DateTime @default(now())
  pickedUpAt DateTime?
  outForDeliveryAt DateTime?
  completedAt DateTime?
  updatedAt DateTime @updatedAt
  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: Restrict)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([shopId,status])
  @@index([employeeId,status])
}

// One return case per shop order; status is independent of fulfilment status.
model ShopReturn {
  id String @id @default(uuid()) @db.Uuid
  shopOrderId String @unique @db.Uuid
  employeeId String? @db.Uuid
  status String @default("REQUESTED") @db.VarChar(32)
  reason String @db.VarChar(500)
  decisionNote String? @db.VarChar(500)
  failureReason String? @db.VarChar(250)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shopOrder ShopOrder @relation(fields:[shopOrderId],references:[id],onDelete:Restrict)
  employee Employee? @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  @@index([employeeId,status])
  @@index([status,createdAt])
}

// COD cash custody. Payment becomes PAID only after shop owner verifies handover.
model DeliveryCodCollection {
  id String @id @default(uuid()) @db.Uuid
  assignmentId String @unique @db.Uuid
  paymentId String @unique @db.Uuid
  shopId String @db.Uuid
  amount Decimal @db.Decimal(12,2)
  status String @default("COLLECTED") @db.VarChar(24)
  collectedAt DateTime @default(now())
  verifiedAt DateTime?
  verifiedBy String? @db.Uuid
  createdAt DateTime @default(now())
  assignment DeliveryAssignment @relation(fields:[assignmentId],references:[id],onDelete:Restrict)
  payment Payment @relation(fields:[paymentId],references:[id],onDelete:Restrict)
  @@index([shopId,status])
}


// Shop-scoped reusable employee role created inline from Employee Management.
model ShopEmployeeRole {
  id String @id @default(uuid()) @db.Uuid
  shopId String @db.Uuid
  code String @unique @db.VarChar(60)
  name String @db.VarChar(80)
  defaultPermissions Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, name])
  @@index([shopId])
}
